# === Omniroute secrets — NEVER commit these ===
omniroute.yaml
.env
.env.local
.env.*.local

# API keys / credentials
*.key
*.pem
secrets/
credentials/

# Cloudflare / wrangler
.wrangler/
wrangler.toml
.dev.vars

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.tmp

# Logs
*.log
logs/

# Local state / databases
.omniroute/
*.db
*.sqlite
*.sqlite3

.env
data/
watchdog-errors.log

  caddy-proxy:
    image: caddy:latest
    container_name: caddy-proxy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile
      - caddy_data:/data
      - caddy_config:/config
      - ./data/logs:/var/log/caddy
    networks:
      - omniroute-tier
    depends_on:
      - omniroute-gateway

volumes:
  caddy_data:
  caddy_config:
